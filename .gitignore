# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# The decompressed catalog DB regenerates from the tracked .bz2 in one command
# (see corpus/README.md) — 97 MB is too close to GitHub's 100 MB hard file-size
# limit to track directly, and a compressed, regenerable binary has no business
# living in git history uncompressed anyway.
corpus/catalogs/catalogs.db

# engine/catalog-bundle/ regenerates from catalogs.db via postinstall (build-catalog-
# bundle.mjs) -- same reasoning as catalogs.db itself: cheap to regenerate, and a
# committed-but-derived JSON bundle would silently drift from catalogs.db the first time
# someone refreshes it and doesn't remember this script exists.
engine/catalog-bundle/

# frontend/api/*.js(.map) are esbuild output generated from frontend/api-src/*.ts by
# scripts/bundle-api.mjs -- deliberately COMMITTED, not gitignored, unlike every other
# generated artifact in this repo. Confirmed live (Phase 4g, deploy #4): Vercel decides
# which files under api/ are functions by scanning the git checkout BEFORE running any
# install/build command -- a file that only exists because prebuild generated it mid-build
# is invisible to that scan, so the deployed route 404s even though the build itself
# succeeds. Regenerate with `node scripts/bundle-api.mjs` (or just `npm run build`, which
# already runs it) and re-commit the output whenever api-src/*.ts or its sat-client
# dependency changes -- same "generated but must be re-committed deliberately" discipline
# already applied to frontend/public/demo/muestra-cfdi.zip, for a different reason.

# Env / secrets
.env
.env.local
*.local

# OS junk
.DS_Store
Thumbs.db

# Session handoffs (docs/HANDOFF.md etc.) — written when chat context fills up,
# not project documentation meant to live in the repo history.
docs/

# Editor
.vscode/*
!.vscode/extensions.json
