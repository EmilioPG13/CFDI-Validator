# Copy to .env for local dev (or .env.local). Vite only exposes vars prefixed VITE_ to
# client code -- see src/vite-env.d.ts for the ImportMetaEnv augmentation.

# Base URL of the Phase 5 backend (Express, a genuinely separate origin -- Render in
# production, http://localhost:3001 in dev, matching backend/src/env.ts's PORT default).
# Falls back to http://localhost:3001 in src/lib/backendApi.ts if unset, so local dev
# works with zero .env at all as long as `backend/` is running on its default port.
VITE_BACKEND_URL="http://localhost:3001"

# Must match backend/.env's own INTERNAL_DRAIN_TOKEN exactly -- protects
# POST /internal/drain-queue from casual abuse (it has no user session at all, by design:
# an unauthenticated demo visitor's browser must be able to call it). Shipping this in a
# public bundle is the accepted tradeoff of that design, not a leak -- see
# src/lib/backendApi.ts's own comment on why.
VITE_INTERNAL_DRAIN_TOKEN=""
