# Copy to .env for local dev. Every var here is required -- env.ts fails fast at boot if
# any is missing, deliberately (a backend that silently issues JWTs signed with `undefined`
# is a worse failure mode than one that refuses to start -- see CLAUDE.md's node:sqlite /
# fail-loud precedent for the same reasoning applied elsewhere in this repo).

# Postgres connection string. Free tier: Neon (https://neon.tech) -- see backend/README.md.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NVIDIA NIM. Get a key at https://build.nvidia.com.
NVIDIA_API_KEY="nvapi-..."
NIM_BASE_URL="https://integrate.api.nvidia.com/v1"
# Free tier is ~40 req/min per key across ALL models. Paced pre-emptively (see
# src/llm/rateLimiter.ts), kept under the documented cap deliberately.
NIM_RPM_LIMIT="32"

# Long random string signing the auth cookie's JWT. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# The Vercel-hosted frontend's real origin -- used for CORS allowlist AND must match what
# the auth cookie's SameSite=None; Secure policy is set against (see CLAUDE.md's CORS note).
FRONTEND_URL="https://cfdi-validator.vercel.app"

# Shared secret protecting POST /internal/drain-queue -- this endpoint has no user auth
# (must be reachable by an unauthenticated demo user's browser and an optional keep-warm
# cron ping) but must not be open to abuse of a cost-bearing external API.
INTERNAL_DRAIN_TOKEN=""

# Bootstrap admin, read once by `npm run prisma:seed`. No public API path can ever create
# an ADMIN -- this env-var + seed-script route is the only one that exists, deliberately.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
